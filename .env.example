# 复制本文件为 .env 后填写真实值；不要将含密钥的 .env 提交到版本库。

# --- AGICTO（qwen-agent-multi-files.py）OpenAI 兼容接入，文档：https://docs.agicto.com/
# 与示例一致：base_url 最终为 https://api.agicto.cn/v1（脚本会自动补 /v1）
AGICTO_BASE_URL=https://api.agicto.cn
AGICTO_API_KEY=
# 与 OpenAI 示例 model="deepseek-v4-flash" 一致，可按模型广场修改
AGICTO_MODEL=deepseek-v4-flash

# --- 其他脚本（如 assistant_ticket_bot-3.py）若仍用 DashScope
# DASHSCOPE_API_KEY=

# --- Tavily MCP（可选）：配置 Key 后可在 GUI 中按本轮开关使用联网搜索
# 需要本机可执行 npx；如 npx 不在 PATH，可填写 TAVILY_MCP_COMMAND，例如 C:\Program Files\nodejs\npx.cmd
TAVILY_API_KEY=
# TAVILY_MCP_COMMAND=

# 可选：qwen-agent 代码解释器工作目录（不设则走框架默认）
# M6_CODE_INTERPRETER_WORK_DIR=
